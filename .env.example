NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Sanity web reads and writes (the dataset is private)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-02
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Intelligent search (server only)
SANITY_CONTEXT_MCP_URL=
SANITY_CONTEXT_SLUG=lopsis-learning-search
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-3.6-flash

# Standalone Studio (copy these entries into studio/.env.local)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Unattended Sanity CLI auth for studio/content:publish in CI (server-side only)
SANITY_AUTH_TOKEN=

# Bunny Stream API for provider thumbnail ingest (server-side only)
BUNNY_STREAM_API_KEY=
BUNNY_LIBRARY_ID=
