{
  "name": "lopsis-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy:graphql": "sanity graphql deploy",
    "schema:deploy": "sanity schemas deploy",
    "typecheck": "tsc --noEmit",
    "typegen": "sanity schema extract --path schema.json --enforce-required-fields && sanity typegen generate",
    "ingest:videos": "sanity exec scripts/ingest-videos.ts --with-user-token",
    "assets:upload": "sanity exec scripts/seed/upload-missing-assets.ts --with-user-token",
    "seed": "sanity exec scripts/seed/seed-content.ts --with-user-token",
    "content:guard": "sanity exec scripts/check-dataset.ts",
    "content:publish": "npm run content:guard && npm run assets:upload && npm run seed && npm run schema:deploy && npm run deploy"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.1",
    "@sanity/vision": "^5.31.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^5.31.2",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5"
  }
}
